{
  "name": "ai-travel-planner",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:server": "pnpm --dir apps/server dev",
    "build": "turbo build",
    "build:server": "pnpm --dir apps/server build",
    "build:unified": "pnpm --dir apps/server build && pnpm --dir apps/web build",
    "start": "pnpm start:unified",
    "start:server": "NODE_ENV=production pnpm --dir apps/server start:dotenv",
    "start:unified": "NODE_ENV=production SERVE_WEB=true pnpm --dir apps/server start:dotenv",
    "deploy:pm2:start": "pnpm build:unified && pm2 start deploy/pm2/ecosystem.config.cjs --env production",
    "deploy:pm2:reload": "pnpm build:unified && pm2 reload deploy/pm2/ecosystem.config.cjs --env production",
    "deploy:pm2:logrotate": "bash deploy/pm2/setup-logrotate.sh",
    "deploy:pm2:release": "bash deploy/pm2/release-zero-downtime.sh",
    "deploy:systemd:install": "sudo bash deploy/systemd/install-unified-service.sh",
    "deploy:systemd:uninstall": "sudo bash deploy/systemd/uninstall-unified-service.sh",
    "deploy:systemd:release": "bash deploy/systemd/release-atomic.sh",
    "deploy:systemd:prune": "bash deploy/systemd/prune-old-releases.sh",
    "deploy:smoke": "bash deploy/smoke-test.sh",
    "deploy:docker:build": "docker build -f deploy/docker/Dockerfile.unified -t ai-travel-planner:server-web .",
    "deploy:docker:up": "docker compose -f deploy/docker/docker-compose.unified.yml up -d --build",
    "deploy:docker:up:staging": "docker compose -f deploy/docker/docker-compose.profiles.yml --profile staging up -d --build",
    "deploy:docker:up:production": "docker compose -f deploy/docker/docker-compose.profiles.yml --profile production up -d --build",
    "docker:stack:build": "docker compose --env-file .env -f deploy/docker/docker-compose.stack.yml build",
    "docker:stack:up": "docker compose --env-file .env -f deploy/docker/docker-compose.stack.yml up -d --build",
    "docker:stack:down": "docker compose --env-file .env -f deploy/docker/docker-compose.stack.yml down",
    "db:local:up": "docker compose -f deploy/docker/docker-compose.local-data.yml up -d --wait postgres mongodb && node scripts/init-local-docker-postgres.mjs",
    "db:local:down": "docker compose -f deploy/docker/docker-compose.local-data.yml down",
    "db:local:init": "pnpm --dir apps/server db:init",
    "db:seed:vietnam-cities": "node apps/server/scripts/seed-vietnam-cities.mjs",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "test": "vitest run --pool forks",
    "test:security": "vitest run --pool forks tests/unit/apps/server/shared/local-jwt.test.ts tests/unit/apps/server/shared/jwt-auth.guard.security.test.ts tests/unit/apps/server/modules/auth tests/unit/apps/web/lib/local-auth.security.test.ts tests/unit/apps/web/lib/session-fetch.security.test.ts tests/unit/apps/server/cors-origin.test.ts tests/unit/apps/server/modules/workspace-rbac.service.test.ts",
    "test:security:e2e": "DOCUMENT_STORE=postgres playwright test --config playwright.server.config.ts auth-security.spec.ts",
    "test:coverage": "vitest run --pool forks --coverage",
    "test:e2e": "playwright test",
    "test:e2e:server": "playwright test --config playwright.server.config.ts",
    "test:e2e:web": "E2E_TARGET=web playwright test",
    "test:e2e:mobile": "E2E_TARGET=mobile playwright test",
    "test:e2e:full-flow": "playwright test e2e/specs/web.full-flow.spec.ts e2e/specs/mobile-web.full-flow.spec.ts",
    "test:e2e:full-flow:web": "E2E_TARGET=web playwright test e2e/specs/web.full-flow.spec.ts --project=web-desktop",
    "test:e2e:full-flow:mobile": "E2E_TARGET=mobile playwright test e2e/specs/mobile-web.full-flow.spec.ts --project=mobile-web",
    "test:e2e:web-mobile-responsive": "E2E_TARGET=web playwright test --project=web-mobile-responsive",
    "test:e2e:auth:flow": "E2E_TARGET=web playwright test e2e/specs/web.auth.contract.spec.ts --project=web-desktop && E2E_TARGET=mobile playwright test e2e/specs/mobile-web.auth.contract.spec.ts --project=mobile-web",
    "test:e2e:auth:error-http": "E2E_TARGET=web playwright test e2e/specs/web.auth.error.contract.spec.ts --project=web-desktop",
    "test:e2e:auth:local": "playwright test --config playwright.local-auth.config.ts",
    "test:e2e:auth": "pnpm test:e2e:auth:local && pnpm test:e2e:auth:flow && pnpm test:e2e:auth:error-http",
    "test:e2e:install": "playwright install chromium",
    "test:regression:local-auth": "node e2e/regression/local-postgres-auth.mjs",
    "docker:dev": "docker compose --env-file .env -f deploy/docker/docker-compose.stack.yml -f deploy/docker/docker-compose.dev.yml up --build --watch",
    "demo:up": "node scripts/demo-tunnel.mjs up",
    "demo:url": "node scripts/demo-tunnel.mjs url",
    "demo:rebuild": "node scripts/demo-tunnel.mjs rebuild",
    "demo:watch": "NEXT_PUBLIC_API_URL= docker compose --env-file .env -f deploy/docker/docker-compose.stack.yml -f deploy/docker/docker-compose.dev.yml --profile demo watch --no-up"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.0",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "smtp-server": "^3.19.22",
    "turbo": "^2.9.14",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0 <26.0.0",
    "pnpm": "10.15.0"
  }
}
