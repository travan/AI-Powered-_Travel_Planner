{
  "name": "@travel/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "dev:unified": "SERVE_WEB=true dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:unified": "SERVE_WEB=true node dist/index.js",
    "start:dotenv": "dotenv -e ../../.env -- node dist/index.js",
    "start:unified:dotenv": "SERVE_WEB=true dotenv -e ../../.env -- node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@supabase/supabase-js": "^2.49.0",
    "@travel/ai": "workspace:*",
    "@travel/scrapers": "workspace:*",
    "@travel/types": "workspace:*",
    "bullmq": "^5.4.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.12.0",
    "next": "^15.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
