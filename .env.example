# ─── AI Providers ─────────────────────────────────────────
AI_PROVIDER=openai                          # openai | gemini | claude
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=...

# ─── Database ─────────────────────────────────────────────
DATABASE_PROVIDER=postgres                  # postgres | supabase
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/travel_planner

# Required only when DATABASE_PROVIDER=supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── MongoDB (local cache/metadata/prompt history) ────────
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=travel_planner

# ─── Redis (Upstash) ──────────────────────────────────────
REDIS_URL=rediss://default:token@host:6380
REDIS_TOKEN=...

# ─── External APIs ────────────────────────────────────────
GOOGLE_PLACES_API_KEY=...
SKYSCANNER_API_KEY=...
BOOKING_AFFILIATE_ID=...
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
SUNRISE_SUNSET_BASE_URL=https://api.sunrise-sunset.org

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
JWT_SECRET=replace-with-at-least-32-characters-local-secret
NODE_ENV=development
PORT=3001
SERVE_WEB=false
WEB_APP_DIR=../web
# Set to "true" only in local dev / isolated test environments when using mock auth tokens
TEST_ENABLE_MOCK_TOKENS=false

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_MAX=60          # requests per window
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
FREE_DAILY_GENERATE_LIMIT=3
