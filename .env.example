# ─── AI Providers ─────────────────────────────────────────
AI_PROVIDER=openai                          # openai | gemini | claude | ollama
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=...
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_OVERVIEW_MODEL=gemma4:latest
OLLAMA_DETAIL_MODEL=qwen3.5:9b
# Direct browser-to-API requests avoid the web proxy timing out on slow local models.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Primary SQL Database ─────────────────────────────────
# postgres = local/self-hosted PostgreSQL through POSTGRES_URL
# supabase = Supabase PostgreSQL through SUPABASE_DATABASE_URL or DATABASE_URL
DATABASE_PROVIDER=postgres
# Host machine local dev:
POSTGRES_URL=postgres://travel_planner:travel_planner@localhost:5433/travel_planner
# Local bootstrap/admin connection used only by `pnpm db:local:init`.
POSTGRES_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres
POSTGRES_PORT=5433
POSTGRES_APP_USER=travel_planner
POSTGRES_APP_PASSWORD=travel_planner
DATABASE_URL=
# Docker compose overrides POSTGRES_URL/DATABASE_URL to:
# postgres://travel_planner:travel_planner@postgres:5432/travel_planner
SUPABASE_DATABASE_URL=

# ─── Authentication ───────────────────────────────────────
# Web defaults to first-party local auth. Set both values to "supabase" only
# when the matching public Supabase URL/key below is configured.
AUTH_PROVIDER=local
NEXT_PUBLIC_AUTH_PROVIDER=local
ENABLE_MOCK_AUTH_SERVER=false

# ─── Supabase API/Auth (optional) ─────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Set one supported public key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Select `local` for the shared server API or `supabase` for hosted auth.
# Isolated E2E can enable the mock provider.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_ENABLE_MOCK_AUTH=false
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_PROVIDER=local

# ─── MongoDB ──────────────────────────────────────────────
# Host machine local dev:
MONGODB_URI=mongodb://localhost:27017/travel_planner
# Docker compose overrides MONGODB_URI to:
# mongodb://mongo:27017/travel_planner
MONGODB_DB_NAME=travel_planner

# ─── Redis (Upstash) ──────────────────────────────────────
REDIS_URL=rediss://default:token@host:6380
REDIS_TOKEN=...

# ─── External APIs ────────────────────────────────────────
GOOGLE_PLACES_API_KEY=...
SKYSCANNER_API_KEY=...
BOOKING_AFFILIATE_ID=...
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
SUNRISE_SUNSET_BASE_URL=https://api.sunrise-sunset.org

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
JWT_SECRET=change-this-development-secret-to-32-chars-minimum
NODE_ENV=development
PORT=3001
SERVE_WEB=false
WEB_APP_DIR=../web
# Set to "true" only in local dev / isolated test environments when using mock auth tokens
TEST_ENABLE_MOCK_TOKENS=false

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_MAX=60          # requests per window
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
TRUST_PROXY_HOPS=0         # set to the exact number of trusted reverse proxies in front of the API
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
FREE_DAILY_GENERATE_LIMIT=3

# API password recovery (independent of DATABASE_PROVIDER)
# AUTH_PROVIDER=local uses application users; supabase uses Supabase Auth.
# Match AUTH_PROVIDER with NEXT_PUBLIC_AUTH_PROVIDER and EXPO_PUBLIC_AUTH_PROVIDER.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# NEXT_PUBLIC_APP_URL must be the public web origin (HTTPS in production).

# Google OAuth: local auth remains the session owner. Keep disabled until configured.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# cloudflare | grafana | off (Grafana only receives application logs)
LOG_SINK=cloudflare
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=

# Genuine public app URL/contact for MET Norway and Nominatim identification
WEATHER_CONTACT_URL=
# Optional configurable Nominatim-compatible service
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
